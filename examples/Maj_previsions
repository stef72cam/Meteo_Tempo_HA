# Alternative au scan toutes les 2 h : régler scan_interval à 86400.
# À coller dans l’éditeur YAML d’une automatisation HA.
# Vérifier que homeassistant.update_entity déclenche effectivement le capteur.
alias: Tempo - Mise à jour prévisions V2
description: "Actualisation ciblée sur les publications RTE"
triggers:
  - trigger: time
    at:
      - "06:45:00"
      - "09:45:00"
      - "10:45:00"
      - "12:15:00"
      - "15:15:00"
      - "19:15:00"
      - "22:00:00"
actions:
  - action: homeassistant.update_entity
    target:
      entity_id: sensor.tempo_prevision_simple
mode: single
